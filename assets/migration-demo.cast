[0.259, "o", "\"\"\"Blocking upstream client. One thread per in-flight request.\"\"\"\r\nimport time\r\nfrom concurrent.futures import ThreadPoolExecutor\r\n\r\nLATENCY = 0.05  # upstream round trip\r\n\r\n\r\ndef fetch(key):\r\n    time.sleep(LATENCY)          # the upstream call\r\n    return {\"key\": key, \"ok\": True}\r\n\r\n\r\n"]
