[0.421, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.000, "o", "\u001b[38;5;245m#  claudectl — a migration, spread across the hive\u001b[0m\r\n"]
[0.000, "o", "\u001b[38;5;245m#  three services to port. One machine would do them one at a time.\u001b[0m\r\n"]
[2.008, "o", "\r\n\u001b[38;5;245m# The codebase: every service still calls the blocking 4-thread client.\u001b[0m\r\n\r\n"]
